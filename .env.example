# ============================================================
# Construction Site Safety Monitor — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in your actual values.
# Never commit the real `.env` file — it is gitignored.

# ---- Roboflow (Stage 1 — Dataset Download) ----
# Get your API key: https://app.roboflow.com/settings → API Key
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# ---- OpenRouter (Stage 8 — LLM Report Summary, optional) ----
# OpenRouter is an OpenAI-compatible gateway. If a key is provided,
# the PDF supervisor summary uses GPT-4o-mini via OpenRouter.
# If left blank, the system falls back to rule-based summaries.
# Get your API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Backend Server (Stage 0) ----
# Host and port for the FastAPI dev server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---- Frontend Dev Server (Stage 0) ----
# Vite dev server port (must match CORS in backend/src/api/main.py)
FRONTEND_PORT=5173

# ---- TTS (Stage 5) ----
# Backend: "edge" (default) or "gtts"
TTS_BACKEND=edge
# edge-tts voice (see https://github.com/rany2/edge-tts)
TTS_VOICE=en-US-AriaNeural
# Master toggle
TTS_ENABLED=true

# ---- Detection (Stage 2) ----
# Path to trained YOLOv8 weights (relative to repo root)
MODEL_PATH=artifacts/stage2_model/best.pt
# Confidence threshold (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.5
